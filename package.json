{
  "name": "contribution-bubbles",
  "version": "0.1.0",
  "description": "A GitHub contribution chart drawn as bubbles. One line of React, just a username.",
  "license": "MIT",
  "author": "Gal Zorigo",
  "keywords": [
    "github",
    "contributions",
    "react",
    "chart",
    "heatmap",
    "calendar"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galzorigo/contribution-bubbles.git"
  },
  "homepage": "https://github.com/galzorigo/contribution-bubbles#readme",
  "bugs": {
    "url": "https://github.com/galzorigo/contribution-bubbles/issues"
  }
}
